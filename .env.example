# Satu SESSION_SECRET untuk semua akun (tetap diperlukan untuk tanda tangan sesi login)
SESSION_SECRET=ganti_dengan_random_secret_panjang_minimal_32_karakter

# Akun ADMINMOK: username login = ADMINMOK
ADMINMOK_PW=ganti_password_admin
ADMINMOK_KEY_1=api_key_emix_milik_admin
ADMINMOK_KEY_2=api_key_emix_kedua_admin

# Akun AISYAH0865: username login = AISYAH0865
AISYAH0865_PW=ganti_password_aisyah
AISYAH0865_KEY_1=api_key_emix_milik_aisyah
AISYAH0865_KEY_2=api_key_emix_kedua_aisyah

# Tambah key berikutnya cukup dengan AISYAH0865_KEY_3, AISYAH0865_KEY_4, dst.
# API key hanya dicari berdasarkan prefix username yang login; tidak fallback ke key global/user lain.
PORT=3000
